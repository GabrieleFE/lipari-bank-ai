# Nome mostrato da FastAPI e dalla risposta /health.
APP_NAME=LipariBank AI

# Ambiente logico: local, test, staging oppure production.
ENVIRONMENT=local

# Abilita dettagli tecnici; mantenere false in staging e production.
DEBUG=true

# URL PostgreSQL asincrono; contiene credenziali locali di sviluppo.
DATABASE_URL=postgresql+asyncpg://lipari:lipari@localhost:5433/lipari_ai

# Credenziale OpenAI: inserire qui il segreto, mai nel codice o nel file tracciato.
OPENAI_API_KEY=

# Credenziale Anthropic: inserire qui il segreto, mai nel codice o nel file tracciato.
ANTHROPIC_API_KEY=

# Modello della chat.
DEFAULT_MODEL=gpt-4o-mini

# Modello della categorizzazione strutturata.
CATEGORIZE_MODEL=gpt-4o-mini

# Modello usato come giudice negli eval.
JUDGE_MODEL=gpt-4o

# Modello e dimensione dei vettori locali usati da ingest e retrieval.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# Limite massimo di token per ogni richiesta al provider LLM.
MAX_TOKENS_PER_REQUEST=2000

# Timeout in secondi per le chiamate ai provider LLM.
LLM_TIMEOUT_SECONDS=60.0

# Budget giornaliero massimo in euro prima di rispondere 429.
MAX_DAILY_COST_EUR=5.0

# Numero massimo di messaggi storici inclusi nel contesto della chat.
HISTORY_MAX_MESSAGES=20

# Segreto per token JWT: generare con python -c "import secrets; print(secrets.token_urlsafe(32))".
JWT_SECRET=
